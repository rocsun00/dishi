{
  "scope": "项目分段，不是古代章号",
  "source_units": [
    {
      "chapter": 1,
      "source_title": "禮記/中庸",
      "source_has_numbered_subchapters": false,
      "project_passages": [
        {
          "id": "ZY-01-001",
          "start": 143,
          "end": 274,
          "marker": "天命之謂性"
        },
        {
          "id": "ZY-01-002",
          "start": 274,
          "end": 319,
          "marker": "仲尼曰"
        },
        {
          "id": "ZY-01-003",
          "start": 319,
          "end": 337,
          "marker": "子曰：「中庸其至"
        },
        {
          "id": "ZY-01-004",
          "start": 337,
          "end": 400,
          "marker": "子曰：「道之不行"
        },
        {
          "id": "ZY-01-005",
          "start": 400,
          "end": 412,
          "marker": "子曰：「道其不行"
        },
        {
          "id": "ZY-01-006",
          "start": 412,
          "end": 457,
          "marker": "子曰：「舜其大知"
        },
        {
          "id": "ZY-01-007",
          "start": 457,
          "end": 505,
          "marker": "子曰：「人皆曰予知"
        },
        {
          "id": "ZY-01-008",
          "start": 505,
          "end": 536,
          "marker": "子曰：「回之爲人"
        },
        {
          "id": "ZY-01-009",
          "start": 536,
          "end": 568,
          "marker": "子曰：「天下國家可均"
        },
        {
          "id": "ZY-01-010",
          "start": 568,
          "end": 685,
          "marker": "子路問強"
        },
        {
          "id": "ZY-01-011",
          "start": 685,
          "end": 746,
          "marker": "子曰：「素隱行怪"
        },
        {
          "id": "ZY-01-012",
          "start": 746,
          "end": 886,
          "marker": "君子之道費而隱"
        },
        {
          "id": "ZY-01-013",
          "start": 886,
          "end": 980,
          "marker": "子曰：「道不遠人"
        },
        {
          "id": "ZY-01-014",
          "start": 980,
          "end": 1088,
          "marker": "君子之道四"
        },
        {
          "id": "ZY-01-015",
          "start": 1088,
          "end": 1210,
          "marker": "君子素其位而行"
        },
        {
          "id": "ZY-01-016",
          "start": 1210,
          "end": 1232,
          "marker": "子曰：「射有似乎"
        },
        {
          "id": "ZY-01-017",
          "start": 1232,
          "end": 1317,
          "marker": "君子之道，譬"
        },
        {
          "id": "ZY-01-018",
          "start": 1317,
          "end": 1416,
          "marker": "子曰：「鬼神之爲德"
        },
        {
          "id": "ZY-01-019",
          "start": 1416,
          "end": 1546,
          "marker": "子曰：「舜其大孝"
        },
        {
          "id": "ZY-01-020",
          "start": 1546,
          "end": 1750,
          "marker": "子曰：「無憂者"
        },
        {
          "id": "ZY-01-021",
          "start": 1750,
          "end": 1944,
          "marker": "子曰：「武王、周公"
        },
        {
          "id": "ZY-01-022",
          "start": 1944,
          "end": 2115,
          "marker": "哀公問政"
        },
        {
          "id": "ZY-01-023",
          "start": 2115,
          "end": 2238,
          "marker": "天下之達道五"
        },
        {
          "id": "ZY-01-024",
          "start": 2238,
          "end": 2302,
          "marker": "子曰：「好學近乎知"
        },
        {
          "id": "ZY-01-025",
          "start": 2302,
          "end": 2429,
          "marker": "「凡爲天下國家有九經"
        },
        {
          "id": "ZY-01-026",
          "start": 2429,
          "end": 2585,
          "marker": "「齊明盛服"
        },
        {
          "id": "ZY-01-027",
          "start": 2585,
          "end": 2643,
          "marker": "「凡爲天下國家有九經，所以"
        },
        {
          "id": "ZY-01-028",
          "start": 2643,
          "end": 2731,
          "marker": "「在下位不獲乎上"
        },
        {
          "id": "ZY-01-029",
          "start": 2731,
          "end": 2783,
          "marker": "「誠者，天之道"
        },
        {
          "id": "ZY-01-030",
          "start": 2783,
          "end": 2914,
          "marker": "「博學之"
        },
        {
          "id": "ZY-01-031",
          "start": 2914,
          "end": 2941,
          "marker": "「自誠明"
        },
        {
          "id": "ZY-01-032",
          "start": 2941,
          "end": 3013,
          "marker": "「唯天下至誠，爲能盡其性"
        },
        {
          "id": "ZY-01-033",
          "start": 3013,
          "end": 3057,
          "marker": "「其次致曲"
        },
        {
          "id": "ZY-01-034",
          "start": 3057,
          "end": 3124,
          "marker": "「至誠之道，可以前知"
        },
        {
          "id": "ZY-01-035",
          "start": 3124,
          "end": 3210,
          "marker": "「誠者自成也"
        },
        {
          "id": "ZY-01-036",
          "start": 3210,
          "end": 3329,
          "marker": "故至誠無息"
        },
        {
          "id": "ZY-01-037",
          "start": 3329,
          "end": 3537,
          "marker": "「天地之道：博也"
        },
        {
          "id": "ZY-01-038",
          "start": 3537,
          "end": 3597,
          "marker": "「大哉聖人之道"
        },
        {
          "id": "ZY-01-039",
          "start": 3597,
          "end": 3637,
          "marker": "「故君子尊德性"
        },
        {
          "id": "ZY-01-040",
          "start": 3637,
          "end": 3692,
          "marker": "「是故居上不驕"
        },
        {
          "id": "ZY-01-041",
          "start": 3692,
          "end": 3796,
          "marker": "子曰：「愚而好自用"
        },
        {
          "id": "ZY-01-042",
          "start": 3796,
          "end": 3834,
          "marker": "子曰：「吾説夏禮"
        },
        {
          "id": "ZY-01-043",
          "start": 3834,
          "end": 4044,
          "marker": "王天下有三重"
        },
        {
          "id": "ZY-01-044",
          "start": 4044,
          "end": 4149,
          "marker": "仲尼祖述堯舜"
        },
        {
          "id": "ZY-01-045",
          "start": 4149,
          "end": 4314,
          "marker": "唯天下至聖"
        },
        {
          "id": "ZY-01-046",
          "start": 4314,
          "end": 4383,
          "marker": "唯天下至誠，爲能經綸"
        },
        {
          "id": "ZY-01-047",
          "start": 4383,
          "end": 4461,
          "marker": "詩曰「衣錦尚絅"
        },
        {
          "id": "ZY-01-048",
          "start": 4461,
          "end": 4506,
          "marker": "詩云：「潛雖伏矣"
        },
        {
          "id": "ZY-01-049",
          "start": 4506,
          "end": 4536,
          "marker": "詩云：「相在爾室"
        },
        {
          "id": "ZY-01-050",
          "start": 4536,
          "end": 4658,
          "marker": "詩曰：「奏假無言"
        }
      ]
    }
  ],
  "later_edition_warning": "朱熹33章为后世章句划分；本项目不拿它替代《礼记》篇本源结构。"
}
