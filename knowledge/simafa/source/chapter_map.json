      "combined_body_end": 2148,
      "selected_raw_sha256": "5f00fa4be7b2f0b3426b10590d49abadb04fe3fea52d58b569c8d5bb9e298a16",
      "passage_count": 15,
      "passage_ids": [
        "SMF-02-001",
        "SMF-02-002",
        "SMF-02-003",
        "SMF-02-004",
        "SMF-02-005",
        "SMF-02-006",
        "SMF-02-007",
        "SMF-02-008",
        "SMF-02-009",
        "SMF-02-010",
        "SMF-02-011",
        "SMF-02-012",
        "SMF-02-013",
        "SMF-02-014",
        "SMF-02-015"
      ],
      "first_body_text": "天子之義，必純取灋天地，而觀於先聖。士庶之義，必奉於父母，而正於君長。故雖有明君，士不先教，不可用也。",
      "last_body_text": "得意則愷歌，示喜也。偃伯靈臺，荅民之勞，示休也。"
    },
