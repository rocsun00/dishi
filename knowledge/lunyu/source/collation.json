    {
      "passage_id": "LY-07-006",
      "working_quote": "狎於德",
      "comparison_quote": "據於德",
      "comparison_source": "07",
      "note": "工作本狎字与注疏经文据字不同；不将电子狎字直接当可靠的孔子用字。"
    },
    {
      "passage_id": "LY-07-017",
      "working_quote": "藝禮",
      "comparison_quote": "《詩》，《書》，執《禮》，皆雅言也。",
      "comparison_source": "07",
      "note": "工作本艺礼与注疏执礼不同，且书名号、句读有别。"
    },
    {
      "passage_id": "LY-13-018",
      "working_quote": "吾黨有德躬者",
      "comparison_quote": "吾黨有直躬者",
      "comparison_source": "13",
      "note": "工作本此处作德躬，注疏经文作直躬；不以疑字消解本章亲亲与直的张力。"
    },
    {
      "passage_id": "LY-14-036",
      "working_quote": "何以報德？以德報怨，以德報德。",
      "comparison_quote": "以直報怨，以德報德。",
      "comparison_source": "14",
      "note": "工作本答语以德与注疏经文以直不同，会改变问答含义；不能据工作本疑字断言孔子赞成以德报怨。"
    },
    {
      "passage_id": "LY-20-002",
      "working_quote": "出納之吝，謂之貪",
      "comparison_quote": "出納之吝謂之有司。",
      "comparison_source": "20",
      "note": "工作本参考注记明确表示据现代研究将传世有司改为贪；这是电子编者有说明的校改，不等于传世本本来如此，亦不据本次有限对读裁定古义。"
    }
